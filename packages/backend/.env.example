# Database
DATABASE_URL=postgresql://user:password@localhost:5432/storees

# Redis
REDIS_URL=redis://localhost:6379

# Shopify App Credentials (from Shopify Partner Dashboard)
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_SCOPES=read_products,write_products,read_customers,write_customers,read_orders,write_orders,read_inventory,read_locations,read_product_listings,read_shipping,read_fulfillments,unauthenticated_read_product_listings,unauthenticated_read_customers,unauthenticated_write_customers,unauthenticated_read_checkouts,unauthenticated_write_checkouts,unauthenticated_read_content,unauthenticated_read_product_tags

# Email
RESEND_API_KEY=re_your_resend_api_key
# Default from-line for projects without a verified per-tenant domain.
# Per-project verified domains override this (Settings → Project → Email).
FROM_EMAIL=Storees <noreply@storees.app>
# Resend webhook signing secret (whsec_...) — required for /api/webhooks/resend
# to accept events. Get from https://resend.com/webhooks → endpoint → Signing Secret
RESEND_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Public base URL for the unsubscribe endpoint (used in List-Unsubscribe header).
# Falls back to APP_URL if unset. Should be HTTPS in production.
UNSUB_BASE_URL=http://localhost:3001

# App URLs
SHOPIFY_APP_URL=http://localhost:3001
SHOPIFY_WEBHOOK_URL=http://localhost:3001/api/webhooks/shopify
MERCHANT_PANEL_URL=http://localhost:3000
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
PORT=3001

# AI (Gemini Flash — free tier from aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key

# Auth
JWT_SECRET=generate_with_openssl_rand_hex_32

# Encryption (for Shopify access tokens at rest)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Demo mode — collapses EVERY flow delay node to this many minutes.
#
# LEAVE THIS UNSET IN PRODUCTION. Unset is not "no demo mode with a sensible
# default" — unset is the correct production behaviour: each delay node honors
# its own configured value and unit. Set it, and a flow built to wait three days
# before a reminder waits this long instead, for every tenant at once.
#
# It ships commented out because this file gets copied to .env verbatim.
# Uncomment only on a demo machine.
# DEMO_DELAY_MINUTES=2

# When the nightly model retrain runs, as HH:MM in UTC (24-hour).
#
# Default 21:30 UTC = 03:00 India — the quiet hours of the shops on this platform.
# Stated in UTC because every other schedule in Storees compares against UTC, so the
# arithmetic happens once here rather than silently somewhere else.
#
# The sweep queues EVERY goal of EVERY project, trained one at a time. Set to `off`
# to disable it entirely and train only when somebody presses Re-train.
#
# This replaced RETRAIN_INTERVAL_HOURS, which counted 24h from process start: every
# restart reset the countdown, so a server redeploying daily never retrained at all.
# RETRAIN_INTERVAL_HOURS=0 is still honoured as an off-switch for existing installs.
# RETRAIN_AT_UTC=21:30
