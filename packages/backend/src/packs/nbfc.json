      "weight": 2.0,
      "decay_half_life_days": 7
    },
    {
      "event_name": "loan_application_started",
      "interaction_type": "intent",
      "weight": 3.0,
      "decay_half_life_days": 7
    },
    {
      "event_name": "documents_uploaded",
      "interaction_type": "strong_intent",
      "weight": 4.0,
      "decay_half_life_days": 14
    },
    {
      "event_name": "loan_disbursed",
      "interaction_type": "conversion",
      "weight": 5.0,
      "decay_half_life_days": 180
    },
    {
      "event_name": "emi_paid",
