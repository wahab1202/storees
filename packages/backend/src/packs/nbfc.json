  "field_defaults": {
    "order": {
      "order_id": "loan_id",
      "amount": "amount",
      "currency": "currency",
      "discount": "discount"
    }
  },
  "cadence_signal": "event:emi_paid",
  "prediction_goals": [
    {
      "name": "Loan Conversion Propensity",
      "target_event": "purchase",
      "observation_window_days": 60,
      "prediction_window_days": 14,
      "min_positive_labels": 150,
      "priority": 1,
      "default_status": "active",
      "description": "Predict which leads are likely to complete loan disbursement"
    },
    {
      "name": "EMI Default Risk",
      "target_event": "emi_overdue",
      "observation_window_days": 90,
      "prediction_window_days": 30,
      "min_positive_labels": 100,
      "priority": 2,
      "default_status": "active",
      "description": "Identify borrowers likely to miss EMI payments in the next 30 days"
    },
    {
      "name": "App Churn Risk",
      "target_event": "dormancy",
      "observation_window_days": 60,
      "prediction_window_days": 30,
      "min_positive_labels": 80,
      "priority": 3,
      "default_status": "active",
      "description": "Borrowers who go quiet on every channel. Targets `dormancy` (no activity of any kind) and NOT `churn`, which means 'did not buy again' and for a lender reads as 'did not take a second loan' \u2014 true of nearly every healthy borrower. Do not rename this goal to plain 'Churn Risk': that wording is in the resolver's name table and would silently switch it back to the purchase-based label."
    },
    {
      "name": "Cross-sell Propensity",
      "target_event": "loan_application_started",
      "observation_window_days": 90,
      "prediction_window_days": 30,
      "min_positive_labels": 200,
      "priority": 4,
      "default_status": "paused",
      "description": "Identify existing customers likely to apply for a new loan product"
    },
    {
      "name": "Pre-closure Likelihood",
      "target_event": "loan_pre_closed",
      "observation_window_days": 60,
      "prediction_window_days": 14,
      "min_positive_labels": 100,
      "priority": 5,
      "default_status": "paused",
      "description": "Predict which borrowers are likely to close their loan early"
    },
    {
      "name": "Top-up Interest",
      "target_event": "top_up_inquiry",
      "observation_window_days": 30,
      "prediction_window_days": 7,
      "min_positive_labels": 80,
      "priority": 6,
      "default_status": "paused",
      "description": "Identify customers likely to inquire about loan top-ups"
    }
  ],
  "segment_templates": [
    {
      "name": "Active Borrowers",
      "description": "Customers with at least one active loan",
      "icon": "\ud83d\udcb0",
      "filter": {
        "logic": "AND",
        "rules": [
          {
            "field": "active_loans",
            "operator": "greater_than",
            "value": 0
          }
        ]
      }
    },
    {
      "name": "EMI Overdue",
      "description": "Customers with overdue EMI payments",
      "icon": "\ud83d\udd34",
      "filter": {
        "logic": "AND",
        "rules": [
          {
            "field": "emi_overdue",
            "operator": "is_true",
            "value": true
          }
        ]
      }
    },
    {
      "name": "KYC Pending",
      "description": "Customers with incomplete KYC",
      "icon": "\ud83d\udccb",
      "filter": {
        "logic": "AND",
        "rules": [
          {
            "field": "kyc_status",
            "operator": "is",
            "value": "pending"
          }
        ]
      }
    },
    {
      "name": "High Net Worth",
      "description": "Borrowers whose lifetime disbursed value is above \u20b910,00,000. Filters on `total_spent`, which for a lender IS the disbursed total \u2014 the orders table holds one row per loan. The template asked for `total_disbursed`, a field that exists nowhere, so it matched nobody.",
      "icon": "\ud83d\udc8e",
      "filter": {
        "logic": "AND",
        "rules": [
          {
            "field": "total_spent",
            "operator": "greater_than",
            "value": 1000000
          }
        ]
      }
    },
    {
      "name": "Repeat Borrowers",
      "description": "Borrowers with more than one loan. Filters on `total_orders`, which for a lender counts loans. The template asked for `total_loans`, a field that exists nowhere.",
      "icon": "\ud83d\udd04",
      "filter": {
        "logic": "AND",
        "rules": [
          {
            "field": "total_orders",
            "operator": "greater_than",
            "value": 1
          }
        ]
      }
    },
    {
      "name": "Collection Bucket 1",
      "description": "1-30 days past due",
      "icon": "\u23f0",
      "filter": {
        "logic": "AND",
        "rules": [
          {
            "field": "days_past_due",
            "operator": "between",
            "value": [
              1,
              30
            ]
          }
        ]
      }
    },
    {
      "name": "Collection Bucket 2",
      "description": "31-60 days past due",
      "icon": "\u26a0\ufe0f",
      "filter": {
        "logic": "AND",
        "rules": [
          {
            "field": "days_past_due",
            "operator": "between",
            "value": [
              31,
              60
            ]
          }
        ]
      }
    },
    {
      "name": "NPA Risk",
      "description": "60+ days past due",
      "icon": "\ud83d\udea8",
      "filter": {
        "logic": "AND",
        "rules": [
          {
            "field": "days_past_due",
            "operator": "greater_than",
            "value": 60
          }
        ]
      }
    },
    {
      "name": "Top-up Eligible",
      "description": "Paid 50%+ EMIs, good repayment track record",
      "icon": "\ud83d\udcc8",
      "filter": {
        "logic": "AND",
        "rules": [
          {
            "field": "emi_completion_pct",
            "operator": "greater_than",
            "value": 50
          },
          {
            "field": "emi_overdue",
            "operator": "is_false",
            "value": false
          }
        ]
      }
    }
  ],
