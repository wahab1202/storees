      "weight": 3.0,
      "decay_half_life_days": 180
    },
    {
      "event_name": "loan_applied",
      "interaction_type": "strong_intent",
      "weight": 4.5,
      "decay_half_life_days": 21
    },
    {
      "event_name": "loan_approved",
      "interaction_type": "engage",
      "weight": 3.0,
      "decay_half_life_days": 60
    },
    {
      "event_name": "loan_rejected",
