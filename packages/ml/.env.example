DATABASE_URL=postgresql://user:password@localhost:5432/storees
MODEL_DIR=models
MIN_POSITIVE_LABELS=200

# ── Per-project event mapping (fallback only) ────────────────────────────────
#
# Normally UNSET. The pipeline reads each project's mapping from its connector
# config in the database; these are only consulted when a project has none.
#
# The danger is that this file holds ONE mapping while the database holds many
# projects. An unscoped ML_EVENT_PURCHASE answers for all of them — a lender and
# a course platform both resolved to a shop's `order_placed` that way, and
# nothing failed: they simply trained on an event they never send.
#
# If you must set them, scope them with ML_EVENT_PROJECT_ID so they apply to one
# project only. On a multi-project deployment, leave the whole block unset.
#
# ML_EVENT_PROJECT_ID=
# ML_EVENT_PURCHASE=
# ML_EVENT_VIEW=
# ML_EVENT_CART=
# ML_EVENT_CANCEL=
# ML_EVENT_IGNORE=
# ML_EVENT_SIGNALS=

# ── Cart model: memory for day reuse ─────────────────────────────────────────
#
# The cart model is the only one that rebuilds its features ONCE PER DAY rather
# than once per fold — a cart opened on the 1st must be described by what was
# known on the 1st, or the model sees its own answer. Measured on GoWelmart that
# is 1,848 day-builds per retrain, of which only 475 are different; the rest are
# a question already answered, asked again by the next candidate window.
#
# Keeping each answer costs memory (~5 MB a day on a busy shop), so it is
# bounded. On reaching the budget it STOPS STORING and builds the rest the old
# way: slower, never swapping. The ceiling is the only thing to tune.
#
#   512 MB   (default)  holds 104 of 475 days   ~1.2x faster
#  3072 MB              holds all 475           ~3.9x faster
#
# A server with room should raise it — 2.3 GB holds a project the size of
# GoWelmart outright, and the reuse is exact: the same day, the same look-back,
# the same numbers. Verified against full rebuilds on two projects with AUC,
# selected features and chosen windows identical.
#
# ML_CART_DAY_CACHE_MB=512
#
# Set to 0 to rebuild every day from scratch, as before this existed.
# ML_CART_DAY_CACHE=1

# ── Window scaffold rollback ─────────────────────────────────────────────────
#
# Training uses 1 snapshot and 2 held-out rounds. It was 2 and 3; both numbers
# SPEND HISTORY (`horizon_cap` subtracts them before deciding how far ahead a
# goal may forecast, `needed()` adds them back before deciding which look-backs
# fit), so asking for fewer returns that history to the question. Measured on
# GoWelmart: churn +0.0154, purchase +0.0040, dormancy +0.0018, repeat +0.0006,
# and dormancy's candidate grid widened from two options to four.
#
# Set to 1 to restore 2 snapshots and 3 rounds without a code change. Worth
# reaching for if a project's models degrade after this landed — the scaffold
# moves every derived window, so it is the first thing to rule out.
# ML_SCAFFOLD_LEGACY=0

# Force this project's cleaned rows to be re-read from the database on the next run,
# instead of reusing the parquet cache.
#
# Not normally needed: the cache key covers the project's mapping, its config AND the
# SQL of the projections that build those rows, so anything that changes what the cache
# should hold already misses it. This is the lever for the case the key cannot see —
# the same rows arriving in greater number, a reseed or a bulk import on the same day
# with no config change.
# ML_REFRESH=1

# Where those caches live. Defaults to the system temp directory, one directory per
# project per fingerprint, pruned to the current one on every training run.
# ML_CACHE_DIR=/var/tmp/storees-ml
