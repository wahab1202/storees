DATABASE_URL=postgresql://user:password@localhost:5432/storees
MODEL_DIR=models
MIN_POSITIVE_LABELS=200

# ── Per-project event mapping (fallback only) ────────────────────────────────
#
# Normally UNSET. The pipeline reads each project's mapping from its connector
# config in the database; these are only consulted when a project has none.
#
# The danger is that this file holds ONE mapping while the database holds many
# projects. An unscoped ML_EVENT_PURCHASE answers for all of them — a lender and
# a course platform both resolved to a shop's `order_placed` that way, and
# nothing failed: they simply trained on an event they never send.
#
# If you must set them, scope them with ML_EVENT_PROJECT_ID so they apply to one
# project only. On a multi-project deployment, leave the whole block unset.
#
# ML_EVENT_PROJECT_ID=
# ML_EVENT_PURCHASE=
# ML_EVENT_VIEW=
# ML_EVENT_CART=
# ML_EVENT_CANCEL=
# ML_EVENT_IGNORE=
# ML_EVENT_SIGNALS=
